# --- Base propia (usuarios, sesiones, log) ---
# Producción: postgres://usuario:clave@host:5432/taller
# Desarrollo sin instalar Postgres: pglite://./.data/pglite
DATABASE_URL=postgres://taller:cambiar@taller_db:5432/taller

# Secreto para firmar las sesiones. Generalo con: openssl rand -base64 48
SESSION_SECRET=
# true en producción (HTTPS). false solo para probar en http://localhost
COOKIE_SECURE=true

# --- Odoo (solo lo usa el servidor) ---
ODOO_URL=http://157.180.77.94
ODOO_DB=Odoo
ODOO_USER=
ODOO_API_KEY=
ODOO_TIMEOUT_MS=20000
# true bloquea toda escritura en Odoo (para probar con datos reales sin tocar nada)
ODOO_READONLY=false
# id de fleet.vehicle.state "Para entregar"
ODOO_VEHICLE_STATE_PARA_ENTREGAR=1

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Grupo del taller (avisos de trabajos)
TELEGRAM_CHAT_TALLER=-1004299745056
# Grupo de errores (fallas al escribir en Odoo)
TELEGRAM_CHAT_ERRORES=-5290900995

# Etiqueta de contactos (res.partner.category) que marca a los mecánicos
ODOO_TAG_MECANICO=20
# Etiqueta de contactos de los cobradores (ejecutivos)
ODOO_TAG_EJECUTIVO=24

# --- Primer admin (solo se crea si la base no tiene usuarios) ---
ADMIN_USER=admin
# Mínimo 8 caracteres. Cambiala desde "Cuenta" después de entrar.
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador

# --- Webhook de Cobranzas ---
# Secreto compartido: Cobranzas lo manda para crear acá los usuarios nuevos como cobradores.
# Vacío = webhook apagado. Generalo con: openssl rand -base64 32 (el mismo valor va en TALLER_WEBHOOK_SECRET de Cobranzas)
WEBHOOK_USUARIOS_SECRET=

# --- API para Cobranzas ---
# Con este secreto, Cobranzas usa las mismas rutas /api que la web (también bajo /api/integraciones/cobranzas/...)
# actuando como el usuario de X-Ridder-Usuario, con sus permisos. Vacío = apagada. Distinto de WEBHOOK_USUARIOS_SECRET.
API_COBRANZAS_SECRET=

# --- GPS (Traccar) ---
# Token de API del usuario «Ridder taller» en track.ridder.com.py (Cuenta > Token). Vacío = sin estados de GPS ni cortes.
TRACCAR_URL=https://track.ridder.com.py
TRACCAR_TOKEN=
# Traccar anterior (gps.ridder.com.py), solo lectura: token de un usuario readonly. Vacío = no se consulta.
TRACCAR_ANTERIOR_URL=https://gps.ridder.com.py
TRACCAR_ANTERIOR_TOKEN=
# Google Sheets de monedas publicado como CSV (Archivo > Compartir > Publicar en la web > la hoja > CSV).
# Columnas: «Nro. de Chapa» y «Moneda» (todo lo que no sea «No» cuenta). Vacío = no se usa.
MONEDAS_SHEET_CSV_URL=

# --- Asistencias ---
# Con las dos, el menú muestra «Marcar asistencia»: abre asistencias.ridder.com.py con el mismo usuario, sin pedir otra
# contraseña. ASISTENCIAS_SECRET es el mismo valor que WEBHOOK_SECRET_TALLER en Asistencias. Vacías = no aparece.
ASISTENCIAS_URL=https://asistencias.ridder.com.py
ASISTENCIAS_SECRET=
